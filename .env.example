# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Which LLM every call uses (FR-06 onwards): ollama (local, default) or anthropic
LLM_PROVIDER=ollama

# Local models via Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi4-mini

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
